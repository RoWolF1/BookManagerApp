<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookManagerApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Tích hợp Bootstrap Icons để hiển thị icon đẹp mắt -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BookManagerApp.styles.css" asp-append-version="true" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <!-- Header / Navbar Nền Đen Hiện Đại -->
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark shadow-sm py-2 mb-4">
            <div class="container">
                <!-- Logo & Tên ứng dụng -->
                <a class="navbar-brand fw-bold text-uppercase d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="fs-4">📚</span>
                    <span style="letter-spacing: 0.5px;">Book<span class="text-warning">Manager</span></span>
                </a>

                <!-- Nút toggle khi xem trên điện thoại -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Menu điều hướng -->
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0 ms-md-4 gap-md-2">
                        <li class="nav-item">
                            <a class="nav-link px-3 text-white" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 text-white fw-bold active" asp-area="" asp-controller="Books" asp-action="Index">
                                <i class="bi bi-journal-bookmark me-1 text-warning"></i> Quản lý Sách
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 text-light-emphasis" asp-area="" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-check me-1"></i> Chính sách
                            </a>
                        </li>
                    </ul>

                    <!-- Nút thao tác nhanh bên phải: Thêm sách mới nền xanh lá -->
                    <div class="d-flex align-items-center">
                        <a asp-controller="Books" asp-action="Create" class="btn btn-success btn-sm px-3 fw-semibold shadow-sm d-flex align-items-center gap-2">
                            <i class="bi bi-plus-circle-fill"></i>
                            <span>Thêm Sách Mới</span>
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Khu vực nội dung chính -->
    <div class="container flex-grow-1">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer bg-white text-muted py-3 mt-auto shadow-sm">
        <div class="container text-center">
            <span>&copy; 2026 - <strong>BookManagerApp</strong> | Hệ Thống Quản Lý Kho Sách</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>