@model BookManagerApp.Models.Book

@{
    ViewData["Title"] = "Chỉnh Sửa Sách";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <!-- Cảnh báo khi thiếu thông tin -->
            <div id="alertMissingEdit" class="alert alert-danger alert-dismissible fade show d-none shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Điền thiếu thông tin!</strong> Vui lòng điền đầy đủ trước khi lưu cập nhật.
                <button type="button" class="btn-close" onclick="document.getElementById('alertMissingEdit').classList.add('d-none')"></button>
            </div>

            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0 fw-bold">✏️ Cập Nhật Thông Tin Sách</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" id="editBookForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <!-- Tên sách -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Tác giả & Thể loại -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Author" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <input asp-for="Author" class="form-control" />
                                <span asp-validation-for="Author" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Genre" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <input asp-for="Genre" class="form-control" />
                                <span asp-validation-for="Genre" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Giá bán & Ngày phát hành -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <div class="input-group">
                                    <input asp-for="Price" class="form-control" type="number" step="1000" />
                                    <span class="input-group-text">VNĐ</span>
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="PublishedDate" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <input asp-for="PublishedDate" class="form-control" type="date" />
                                <span asp-validation-for="PublishedDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Ảnh bìa sách (ImageUrl) -->
                        <div class="mb-3">
                            <label asp-for="ImageUrl" class="form-label fw-bold">Ảnh bìa sách (Đường dẫn URL)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-image"></i></span>
                                <input asp-for="ImageUrl" id="inputEditImageUrl" class="form-control" placeholder="Dán link ảnh bìa mới tại đây..." />
                            </div>
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                            <div class="form-text">Dán đường dẫn ảnh mới để thay đổi ảnh bìa cuốn sách.</div>
                        </div>

                        <!-- Khung xem trước ảnh bìa -->
                        <div id="editPreviewContainer" class="text-center p-3 mb-3 bg-light border rounded @(string.IsNullOrEmpty(Model.ImageUrl) ? "d-none" : "")">
                            <span class="d-block text-muted small mb-2 fw-semibold">Xem trước ảnh bìa:</span>
                            <img id="imgEditPreview" src="@Model.ImageUrl" alt="Ảnh bìa xem trước" class="rounded shadow-sm border" style="max-height: 180px; object-fit: contain;" />
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
                            <!-- Nút mở popup xác nhận -->
                            <button type="button" class="btn btn-primary px-4 fw-bold shadow-sm" onclick="confirmEdit()">
                                <i class="bi bi-arrow-repeat me-1"></i> Lưu Cập Nhật
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal xác nhận Sửa -->
<div class="modal fade" id="modalConfirmEdit" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow border-0">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalLabel"><i class="bi bi-question-circle me-2"></i>Xác Nhận Thay Đổi</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                Bạn có chắc chắn muốn lưu lại các thông tin đã chỉnh sửa cho cuốn sách này không?
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Xem lại</button>
                <button type="button" class="btn btn-primary fw-bold" onclick="submitEditForm()">Đồng ý Cập Nhật</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        function confirmEdit() {
            var form = $('#editBookForm');
            if (form.valid()) {
                var modal = new bootstrap.Modal(document.getElementById('modalConfirmEdit'));
                modal.show();
            } else {
                var alertBox = document.getElementById('alertMissingEdit');
                alertBox.classList.remove('d-none');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        function submitEditForm() {
            document.getElementById('editBookForm').submit();
        }

        // Tự động cập nhật ảnh xem trước khi người dùng dán hoặc sửa link ảnh
        const inputUrl = document.getElementById('inputEditImageUrl');
        const previewContainer = document.getElementById('editPreviewContainer');
        const imgPreview = document.getElementById('imgEditPreview');

        inputUrl.addEventListener('input', function() {
            const val = this.value.trim();
            if (val.length > 5) {
                imgPreview.src = val;
                previewContainer.classList.remove('d-none');
            } else {
                previewContainer.classList.add('d-none');
            }
        });

        imgPreview.addEventListener('error', function() {
            previewContainer.classList.add('d-none');
        });
    </script>
}