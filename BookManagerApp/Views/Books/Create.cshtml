@model BookManagerApp.Models.Book

@{
    ViewData["Title"] = "Thêm Sách Mới";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <!-- Hộp cảnh báo khi thiếu thông tin -->
            <div id="alertMissingFields" class="alert alert-danger alert-dismissible fade show d-none shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Điền thiếu thông tin!</strong> Vui lòng kiểm tra lại các trường có dấu (*) và nhập đầy đủ.
                <button type="button" class="btn-close" onclick="document.getElementById('alertMissingFields').classList.add('d-none')"></button>
            </div>

            <div class="card shadow border-0">
                <div class="card-header bg-success text-white py-3">
                    <h5 class="mb-0 fw-bold">📖 Thêm Sách Mới Vào Kho</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" id="createBookForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- 1. Tên sách -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                            <input asp-for="Title" class="form-control" placeholder="Ví dụ: Lập trình C# căn bản" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- 2. Tác giả & Thể loại -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Author" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <input asp-for="Author" class="form-control" placeholder="Tên tác giả..." />
                                <span asp-validation-for="Author" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Genre" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <input asp-for="Genre" class="form-control" placeholder="Ví dụ: Công nghệ thông tin..." />
                                <span asp-validation-for="Genre" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- 3. Giá bán & Ngày phát hành -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <div class="input-group">
                                    <input asp-for="Price" class="form-control" type="number" step="1000" placeholder="150000" />
                                    <span class="input-group-text">VNĐ</span>
                                </div>
                                <span asp-validation-for="Price" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="PublishedDate" class="form-label fw-bold"></label> <span class="text-danger">*</span>
                                <input asp-for="PublishedDate" class="form-control" type="date" />
                                <span asp-validation-for="PublishedDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- 4. TRƯỜNG MỚI: Link Ảnh bìa sách (ImageUrl) & Khung xem trước -->
                        <div class="mb-3">
                            <label asp-for="ImageUrl" class="form-label fw-bold">Ảnh bìa sách (Đường dẫn URL)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-image"></i></span>
                                <input asp-for="ImageUrl" id="inputImageUrl" class="form-control" placeholder="Dán đường link ảnh tại đây (ví dụ: https://.../bia-sach.jpg)" />
                            </div>
                            <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                            <div class="form-text">Dán URL ảnh để xem trước bìa sách bên dưới.</div>
                        </div>

                        <!-- Khung xem trước ảnh bìa -->
                        <div id="previewContainer" class="text-center p-3 mb-3 bg-light border rounded d-none">
                            <span class="d-block text-muted small mb-2 fw-semibold">Xem trước ảnh bìa:</span>
                            <img id="imgPreview" src="" alt="Ảnh bìa xem trước" class="rounded shadow-sm border" style="max-height: 180px; object-fit: contain;" />
                        </div>

                        <!-- Nút bấm -->
                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                            <button type="submit" class="btn btn-success px-4 fw-bold shadow-sm">
                                <i class="bi bi-save me-1"></i> Lưu Thông Tin
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Kiểm tra validation trước khi submit
        document.getElementById('createBookForm').addEventListener('submit', function(e) {
            var form = $(this);
            if (!form.valid()) {
                var alertBox = document.getElementById('alertMissingFields');
                alertBox.classList.remove('d-none');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        });

        // Tự động hiển thị xem trước ảnh ngay khi dán link
        const inputUrl = document.getElementById('inputImageUrl');
        const previewContainer = document.getElementById('previewContainer');
        const imgPreview = document.getElementById('imgPreview');

        inputUrl.addEventListener('input', function() {
            const val = this.value.trim();
            if (val.length > 5) {
                imgPreview.src = val;
                previewContainer.classList.remove('d-none');
            } else {
                previewContainer.classList.add('d-none');
            }
        });

        imgPreview.addEventListener('error', function() {
            previewContainer.classList.add('d-none');
        });
    </script>
}